# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID (Application ID from developer portal)
DISCORD_CLIENT_ID=your_client_id_here

# Discord Guild (Server) ID where the bot will operate
DISCORD_GUILD_ID=your_guild_id_here

# Ratmas Configuration
# Discord Role ID for Ratmas participants (users with this role can join the exchange)
PARTICIPANT_ROLE_ID=your_participant_role_id_here

# Manager User ID (Discord user ID of the bot administrator)
MANAGER_USER_ID=your_manager_user_id_here

# Redis Configuration
# Redis server hostname (use 'redis' for Docker Compose, 'localhost' for local development)
REDIS_HOST=redis
# Redis server port
REDIS_PORT=6379

# Bot Behavior Configuration
# How long to remember the last sender for reply context (in hours)
CONVERSATION_CONTEXT_TIMEOUT_HOURS=24
